# Copy to backend/.env for local development (uvicorn --env-file .env).
# On Vercel these are project environment variables.

# Neon Postgres (the Vercel Neon integration sets this automatically)
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=generate-a-long-random-string
IP_HASH_SALT=generate-another-random-string
RESPONDER_INVITE_CODE=code-you-give-to-agency-staff

# Public URL (used in dispatch links)
SITE_URL=https://davorescue.vercel.app

# AI verification — without a key, reports fall back to rule-based triage
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Dispatch. "test" sends only to the test recipients below; "live" pages the agencies.
DISPATCH_MODE=test
DISPATCH_TEST_PHONES=
DISPATCH_TEST_EMAILS=

# SMS via Termii (Nigerian gateway) — https://termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=DavoRescue
TERMII_CHANNEL=dnd

# Email via Resend — https://resend.com
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=DavoRescue Dispatch <dispatch@your-verified-domain.ng>

# Optional: forward verified incidents to a control-room system
DISPATCH_WEBHOOK_URL=
DISPATCH_WEBHOOK_SECRET=

# Web push (generate with scripts in README)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://davorescue.vercel.app/about

# Road matching (public demo servers by default; self-host for heavy traffic)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
