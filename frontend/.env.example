# Copy to frontend/.env.local for local development. On Vercel these are
# project environment variables (NEXT_PUBLIC_* values are baked in at build).

# Public site URL used for canonical links, sitemap and sharing.
NEXT_PUBLIC_SITE_URL=https://davorescue.vercel.app

# Google Street View inside the maps. Create a browser key in Google Cloud with
# only "Maps Embed API" and "Street View Static API" enabled, restricted to
# HTTP referrers davorescue.vercel.app/* and localhost:3000/*. Without it,
# zooming in offers a link that opens Street View in Google Maps instead.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: a different street-map tile server (e.g. a paid provider at scale).
NEXT_PUBLIC_MAP_TILES_URL=
